<?php

// Configure config.inc.php in this directory; Composer normally creates it for you.
// Local plugin settings override Roundcube's main configuration. See README.md.
// Nothing is enabled by installing the plugin alone.
$config['stalwart_enabled'] = false;
$config['stalwart_api_url'] = '';

// Settings per IMAP server, using exact addresses from Roundcube's imap_host.
// Unlisted servers do not use this plugin. Null keeps single-server settings.
// Multiple IMAP servers require a map; API URLs and client credentials are not inherited.
// Feature flags inherit the defaults below unless overridden in an entry.
// $config['stalwart_hosts'] = [
//     'ssl://mail.example.org:993' => [
//         'api_url' => 'https://mail.example.org/jmap',
//         'twofactor_enabled' => true,
//         'password_driver' => 'stalwart',
//     ],
// ];
$config['stalwart_hosts'] = null;

// Optional native login with a second Stalwart TOTP step. Requires Stalwart 0.16.26.
// Register a dedicated OAuth client and its exact HTTPS redirect URI on Stalwart.
// Use this mode only on servers without active Roundcube redirect OAuth.
$config['stalwart_login_enabled'] = false;
$config['stalwart_login_client_id'] = '';
$config['stalwart_login_client_secret'] = '';
$config['stalwart_login_redirect_uri'] = '';

// Independently enable each native settings page.
$config['stalwart_twofactor_enabled'] = false;
$config['stalwart_app_passwords_enabled'] = false;
// Requires existing account-administration permissions. See README.md.
$config['stalwart_aliases_enabled'] = false;
$config['stalwart_public_keys_enabled'] = false;
// Requires Stalwart Enterprise and the user's MaskedEmail permissions.
$config['stalwart_masked_email_enabled'] = false;

// Optional: select our account-password page instead of another password provider.
// The bundled Password plugin is loaded automatically; no driver installation is needed.
// $config['password_driver'] = 'stalwart';
